# Copy to .env.local and restart npm run dev.

# Where staff and approvers reach Alara. Approval links in emails use this,
# so it must be the public address, not the internal one.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Vercel: set this to https://YOUR-PROJECT.vercel.app (same value as CAPACITOR_SERVER_URL).

# Capacitor APK shell. Emulator → http://10.0.2.2:3001
# Physical phone on same Wi‑Fi → http://YOUR_LAN_IP:3001 (this PC is often 192.168.100.21)
# Production APK → https://your-alara-host.example
CAPACITOR_SERVER_URL=http://192.168.100.21:3001

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by: npx tsx scripts/import-cedar-tenant.ts
# Do not commit these. Password is optional; omit it to send an invite.
CEDAR_ADMIN_EMAIL=
CEDAR_ADMIN_PASSWORD=
CEDAR_ADMIN_NAME=

# Register this redirect on both providers (Phase 5, not Phase 1):
#   http://localhost:3001/api/email/oauth/callback

# Server only. Captions + poster generation.
# Never send uploaded school photos / faces to Gemini for editing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
