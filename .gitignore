# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# mailbox tokens — never commit
/data/email-tokens.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/data/db.json
/public/uploads/*
!/public/uploads/.gitkeep
/public/posts/*
!/public/posts/.gitkeep

.cursor/

# Capacitor / Android local builds
/android/.gradle/
/android/app/build/
/android/build/
/android/captures/
/android/local.properties
*.apk
*.aab
*.keystore
!android/app/debug.keystore
