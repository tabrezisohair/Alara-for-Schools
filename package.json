{
  "name": "school-alara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "dev:local": "next dev -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "lint": "eslint",
    "import:cedar": "npx tsx scripts/import-cedar-tenant.ts",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "cap:apk": "cd android && gradlew.bat assembleDebug && cd .. && node -e \"require('fs').mkdirSync('dist',{recursive:true}); require('fs').copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk','dist/Alara-debug.apk'); console.log('Wrote dist/Alara-debug.apk');\"",
    "cap:phone": "npx cap sync android && npm run cap:apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "jpeg-js": "^0.4.4",
    "next": "16.3.2",
    "pngjs": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
